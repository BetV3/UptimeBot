# CheckPulse app .env — copy to .env on the prod host and fill in.
# Lives next to docker-compose.yml; docker-compose passes it into the
# api, celery-worker, celery-beat, and celery-alerts-worker services.
#
# Pair with deploy/worker.env.example on each regional VPS worker.

# ── Database ──────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is read by docker-compose to initialize the db
# container; the URL passwords below must match. Generate with:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=CHANGE_ME

# Both URLs point at the same Postgres — the async one is used by the
# FastAPI app, the sync one by Alembic migrations and Celery tasks.
DATABASE_URL=postgresql+asyncpg://uptimebot:CHANGE_ME@db:5432/uptimebot
DATABASE_URL_SYNC=postgresql://uptimebot:CHANGE_ME@db:5432/uptimebot

# ── Redis ─────────────────────────────────────────────────────────────
# Celery broker + result backend + beat-heartbeat key. AOF persistence
# is enabled by docker-compose; the data lives in the redis-data volume.
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────
# JWT signing secret. Generate with: openssl rand -hex 32
# Rotating this immediately invalidates every signed-in session.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Access tokens are short-lived; refresh tokens get rotated.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Workers ───────────────────────────────────────────────────────────
# Shared secret the regional VPS workers send as X-Worker-Secret on
# every /internal/* call. Must match WORKER_SECRET in
# /etc/checkpulse/worker.env on each VPS. Rotate by updating both
# sides and restarting.
WORKER_SECRET=CHANGE_ME_random_long_string

# ── Reverse proxy ─────────────────────────────────────────────────────
# Set to true behind any trusted reverse proxy: Cloudflare Tunnel (the
# default in DEPLOY_FIRST.md), Cloudflare proxied DNS, Caddy, nginx, or
# similar. The rate limiter resolves the originating client IP in this
# order:
#   1. CF-Connecting-IP — Cloudflare's first-party header, authoritative
#      when the request passed through Cloudflare.
#   2. Rightmost X-Forwarded-For entry — for a single non-CF proxy hop
#      (Caddy or nginx directly in front of the app).
#   3. The immediate TCP peer.
# The leftmost XFF entry is intentionally ignored — it's client-supplied
# and spoofable; using it would let attackers bypass per-IP rate limits.
#
# Leave false in dev (no proxy) — trusting forwarded headers without a
# proxy in front would defeat the brute-force throttle on /auth/login.
TRUST_FORWARDED_FOR=true

# ── Stripe ────────────────────────────────────────────────────────────
# Live-mode keys for production. Get from dashboard.stripe.com.
# The webhook secret is per-endpoint — register
# https://api.checkpulse.dev/billing/webhook in Stripe first, then
# copy the signing secret that endpoint generates.
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Price IDs of the Starter and Pro recurring prices created in
# Products → Add product. Each plan has one monthly USD price.
STRIPE_STARTER_PRICE_ID=price_CHANGE_ME
STRIPE_PRO_PRICE_ID=price_CHANGE_ME

# Public URL of this deployment — Stripe Checkout uses it for the
# success / cancel redirects. Must be HTTPS in prod or browsers will
# refuse to forward the JWT cookie back.
APP_URL=https://app.checkpulse.dev

# ── App ───────────────────────────────────────────────────────────────
# Name shown in the FastAPI title; doesn't affect routing.
APP_NAME=CheckPulse

# MUST be "production" on the prod host. Two behaviors depend on it:
#  - JWT cookies set Secure=True (browsers refuse them on http://).
#  - Email sender hits Resend; in any other value, emails are logged
#    to stdout instead so dev iteration doesn't burn credits.
APP_ENV=production

# ── Email (Resend) ────────────────────────────────────────────────────
# Resend API key. Domain (checkpulse.dev) must be verified in Resend
# with SPF / DKIM / DMARC records before live sends — see
# LAUNCH_CHECKLIST.md §2.
RESEND_API_KEY=re_CHANGE_ME

# The From address. Must match a verified domain in Resend; mismatches
# silently fail or get rejected.
EMAIL_FROM_ADDRESS=CheckPulse <no-reply@checkpulse.dev>

# How long a verification link is valid (hours). 24 is the default.
VERIFICATION_TOKEN_TTL_HOURS=24
