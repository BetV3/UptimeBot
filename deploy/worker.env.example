# /etc/checkpulse/worker.env — copy to /etc/checkpulse/worker.env on each
# VPS and fill in. chmod 600, owner root:checkpulse.

# Which region this VPS reports as. One of: us, eu, asia.
REGION=us

# Central API endpoint. Must be reachable from this VPS over the public
# internet (or a private network, if configured).
API_URL=https://api.checkpulse.example.com

# Shared secret for /internal/* endpoints. Rotate by updating this file
# and restarting the service on every VPS plus the API nodes.
WORKER_SECRET=CHANGE-ME

# Stable identifier for this worker; used for lease ownership so stale
# submissions from a previously-leased-but-reclaimed worker are dropped.
# Default is platform.node() — set this explicitly if hostnames collide
# across regions (e.g. generic cloud-provider hostnames).
# WORKER_ID=checkpulse-us-1

# Poll cadence (seconds). 10 is a reasonable default; drop to 5 if you
# have tight interval_seconds monitors and want faster dispatch.
POLL_INTERVAL=10
